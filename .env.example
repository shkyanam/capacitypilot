POSTGRES_DSN=postgresql://localhost/capacity_planner_dev
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_CHAT_MODEL=meta-llama/Llama-3.3-70B-Instruct
# Optional: enables semantic filing retrieval when set. Uses the same Nebius API key and base URL.
NEBIUS_EMBEDDING_MODEL=
API_BASE_URL=http://localhost:8000
API_AUTH_TOKEN=replace-with-a-long-random-secret
SEC_USER_AGENT=CapacityPlanner/1.0 your-team@example.com
WORKER_POLL_SECONDS=2
MAX_AGENT_ATTEMPTS=3
MAX_SIGNAL_AGE_HOURS=48
NEWS_API_KEY=
NEWS_LOOKBACK_DAYS=180
NEWS_CACHE_HOURS=24
SEC_MAX_FILINGS_PER_CASE=3
STALE_CASE_MINUTES=15
SEC_MIN_REQUEST_INTERVAL_SECONDS=0.15
NEWS_BULK_COMPANY_INTERVAL_SECONDS=1
NEWS_BULK_COMPANY_LIMIT=100
NEWS_BULK_MAX_ATTEMPTS=3
NEWS_BULK_REFRESH_HOURS=24
# Semantic filing retrieval automatically activates when NEBIUS_EMBEDDING_MODEL is configured.
NEWS_SEMANTIC_ENABLED=true
NEWS_SEMANTIC_CHUNK_CHARS=1200
NEWS_SEMANTIC_TOP_K=3
MEM0_ENABLED=false
MEM0_API_KEY=
MEM0_AGENT_ID=capacity-planner
MEM0_SEARCH_TOP_K=5
MEM0_MAX_ATTEMPTS=3
CAPACITY_INVENTORY_MAX_AGE_HOURS=24
JIRA_ENABLED=false
JIRA_BASE_URL=https://your-company.atlassian.net
JIRA_AUTH_MODE=basic
JIRA_USER_EMAIL=
JIRA_API_TOKEN=
JIRA_BEARER_TOKEN=
JIRA_CAPACITY_PROJECT_KEY=CAP
JIRA_CAPACITY_ISSUE_TYPE=Task
JIRA_HUB_PROJECT_KEY=HUB
JIRA_HUB_ISSUE_TYPE=Task
JIRA_DEFAULT_LABELS=capacity-planner,storage-expansion
JIRA_TIMEOUT_SECONDS=30
JIRA_VERIFY_SSL=true
JIRA_MAX_ATTEMPTS=5
SLACK_ENABLED=false
SLACK_AUTH_MODE=webhook
SLACK_WEBHOOK_URL=
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
SLACK_PLANNER_URL=http://localhost:8501
SLACK_DIGEST_INTERVAL_MINUTES=15
SLACK_MAX_ATTEMPTS=5
SLACK_TIMEOUT_SECONDS=30
SLACK_VERIFY_SSL=true
SLACK_REQUIRE_PRODUCTION_ELIGIBLE=false
SLACK_INCLUDE_TEST_SCENARIOS=false
